# Google AI Studio API key (free tier) — used by agents/ for all LLM reasoning calls.
GOOGLE_API_KEY=

# Snowflake trial account connection details — used by ingestion/load_to_snowflake.py
# and by dbt_project/profiles.yml (via env_var()).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=CLAIM_RESOLVE
SNOWFLAKE_SCHEMA=RAW
